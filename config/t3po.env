# --- Translation: T3PO 14B as GGUF via llama-server (Metal) ---
# llama-server speaks the OpenAI API, so the upstream "vllm" backend works
# unchanged.  It goes through llm_proxy on 8011, which reinstates vLLM's
# min_tokens: llama.cpp ignores that field, and without it every forced
# segment comes back empty and is read as WAIT, so no subtitle ever appears.
TRANSLATION_BACKEND=openai
VLLM_BASE_URL=http://127.0.0.1:8011/v1
VLLM_MODEL=Confucius4-T3PO
VLLM_TIMEOUT_SECONDS=180

# --- ASR: our Mac R2T2 service (torch/MPS) speaking R2T2's own WS protocol ---
ASR_WS_URL=ws://127.0.0.1:8093/asr_stream_api_v1
ASR_SECRET_KEY=test0102
# VAD on: utterance ends are what flush the translation tail, so without it
# subtitles never settle.
ASR_USE_VAD=true
# Empty lets each session's direction pick Chinese/English.
ASR_LANGUAGE=

# --- Web UI ---
LATENCY_MODE=native
HOST=127.0.0.1
PORT=8000
